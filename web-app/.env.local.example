# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.local.example is committed.

# Used by iron-session to sign the auth cookie. Must be at least 32 characters.
SESSION_PASSWORD=replace-with-a-32-or-more-character-secret

# Per-club sent-match store URL.
# - Local development: leave unset or use file:./data/sent.sqlite (created lazily).
# - Production / Vercel: set to the Turso/libSQL database URL, e.g.
#   libsql://my-db-org.turso.io or https://my-db-org.turso.io
SENT_STORE_URL=file:./data/sent.sqlite

# Turso auth token. Required for remote libSQL/Turso URLs; ignored for local file URLs.
SENT_STORE_AUTH_TOKEN=optional-token-for-remote-turso

# Per-club credential overrides. See README.md → "Club credentials (env)".
# Shape: { "<competition>-<code>": { "username": string, "password": string }, ... }
# e.g. "FMP-411" for the FMP club 411 (TISO PATIN), "FGP-438" for the FGP club 438 (HL NOROESTE).
# Malformed values are rejected at startup and treated as empty (fail closed).
CLUB_CREDENTIALS_JSON={"FMP-411":{"username":"tiso","password":"tiso"},"FGP-438":{"username":"artabros","password":"artabros"}}
